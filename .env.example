# --- Mode -------------------------------------------------------------
# mock   = offline rule-based bot (no model, no cost): demos, CI, dry runs.
# ollama = local Ollama on the host (same setup as the other challenges, fully offline).
# api    = any OpenAI-compatible endpoint (settings below).
LLM_MODE=mock

# --- Ollama preset (LLM_MODE=ollama): defaults shown ---------------------
# OPENAI_BASE_URL=http://host.docker.internal:11434/v1   (http://localhost:11434/v1 without Docker)
# LLM_MODEL=llama3.2:1b

# --- API mode (any OpenAI-compatible endpoint) -------------------------
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7

# Presets (uncomment one block):
# Groq:    OPENAI_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=llama-3.1-8b-instant
# Ollama:  OPENAI_BASE_URL=http://host.docker.internal:11434/v1   OPENAI_API_KEY=ollama   LLM_MODEL=llama3
# LiteLLM: OPENAI_BASE_URL=http://host.docker.internal:4000/v1    LLM_MODEL=<your-alias>

# --- Anti-sharing ---------------------------------------------------------
# Seeds per-team puzzles and flag suffixes. Set a long random value for the event.
SECRET_KEY=change-me
# true: every team gets its own flag suffix (flags can't be copied). false: static flags (for CTFd).
DYNAMIC_FLAGS=true

# --- Organiser ---------------------------------------------------------
# Enables /admin (HTTP Basic, any username). Leave empty to disable the admin page.
ADMIN_PASSWORD=change-me
ORGANISATION=
# Host port published by docker compose (container always listens on 8000)
HOST_PORT=5008

# --- Limits ---
MAX_CONCURRENT_LLM=4
LLM_TIMEOUT=60-----------------------------------------------------------
MAX_MESSAGE_CHARS=600
MAX_DOC_CHARS=4000
HISTORY_TURNS=6
RATE_LIMIT_PER_MIN=20

# --- Optional: rotate flags per event (defaults are in app/config.py) ---
# FLAG_L1=FLAG{...}
# FLAG_L2=FLAG{...}
# ... up to FLAG_L10
