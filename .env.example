# --- Mode -------------------------------------------------------------
# mock = offline rule-based bot (no API key, no cost). api = real LLM.
LLM_MODE=mock

# --- API mode (any OpenAI-compatible endpoint) -------------------------
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7

# Presets (uncomment one block):
# Groq:    OPENAI_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=llama-3.1-8b-instant
# Ollama:  OPENAI_BASE_URL=http://host.docker.internal:11434/v1   OPENAI_API_KEY=ollama   LLM_MODEL=llama3
# LiteLLM: OPENAI_BASE_URL=http://host.docker.internal:4000/v1    LLM_MODEL=<your-alias>

# --- Limits --------------------------------------------------------------
MAX_MESSAGE_CHARS=600
MAX_DOC_CHARS=4000
HISTORY_TURNS=6
RATE_LIMIT_PER_MIN=20

# --- Optional: rotate flags per event (defaults are in app/config.py) ---
# FLAG_L1=FLAG{...}
# FLAG_L2=FLAG{...}
# ... up to FLAG_L10
