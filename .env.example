# Copy to .env and edit. Never commit .env.

# ===== REQUIRED =====
# Long random string. The app refuses to start without it (flags/puzzles are derived from it).
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
# Password for /admin and /admin/guide. Admin pages stay disabled while this is "change-me" or empty.
ADMIN_PASSWORD=change-me

# Your flags. Leave a line out and an unguessable one is derived from SECRET_KEY (you can read it in /admin/guide).
# Set all ten if you enter them in an external platform.
# FLAG_L1=FLAG{...}
# FLAG_L2=FLAG{...}
# FLAG_L3=FLAG{...}
# FLAG_L4=FLAG{...}
# FLAG_L5=FLAG{...}
# FLAG_L6=FLAG{...}
# FLAG_L7=FLAG{...}
# FLAG_L8=FLAG{...}
# FLAG_L9=FLAG{...}
# FLAG_L10=FLAG{...}

# ===== Model (Ollama runs on one PC in the lab) =====
LLM_MODE=ollama
# Where the app reaches Ollama: same PC as Docker -> http://host.docker.internal:11434
# Ollama on another PC -> http://<that PC's IP>:11434
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=90
# Simultaneous model calls from this app. Keep equal to OLLAMA_NUM_PARALLEL on the Ollama PC.
MAX_CONCURRENT_LLM=4

# ===== Optional =====
# false: the flags above are the real flags (use with an external platform).
# true: each team gets its own flag suffix; flags only validate inside this app.
DYNAMIC_FLAGS=false
HOST_PORT=5008
RATE_LIMIT_PER_MIN=20
