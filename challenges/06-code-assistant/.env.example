# Copy to .env and edit. Never commit .env.
# Set your real flag here (the committed default in config.py is a placeholder).
# The flag is embedded INSIDE the planted API key, so setting FLAG also sets
# the key (unless you override COMPANY_API_KEY explicitly below).
FLAG=flag{CHANGE_ME}
# Optional: override the planted key outright. By default it is derived as
# sk-live-larkspur-<flag body>.
# COMPANY_API_KEY=sk-live-larkspur-CHANGE_ME
# The fictional company whose codebase DevBot can read.
COMPANY=Larkspur Logistics
REPO_NAME=larkspur-api
# The container reaches the host's Ollama at host.docker.internal (set in the Dockerfile).
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT=120
# Flask session signing key for the (token-only) conversation cookie.
SECRET_KEY=change-me-for-your-event
# The container always listens on 8000; pick the host port with -p 5006:8000.
