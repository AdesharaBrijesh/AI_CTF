# Challenge 01 - Gatekeeper. Copy to .env and fill in real values. Never commit .env.

# --- Secrets (MUST change before the event) ---
SECRET_KEY=change-me
ADMIN_PASSWORD=change-me

# --- Flags (shown to a team when it clears each checkpoint) ---
FLAG_L1=AICTF{CHANGE_ME}
FLAG_L2=AICTF{CHANGE_ME}
FLAG_L3=AICTF{CHANGE_ME}
FLAG_L4=AICTF{CHANGE_ME}
FLAG_L5=AICTF{CHANGE_ME}

# --- Model (Ollama runs on the host) ---
# Docker: http://host.docker.internal:11434   Without Docker: http://localhost:11434
OLLAMA_URL=http://host.docker.internal:11434
MODEL=llama3.2:1b
JUDGE_MODEL=llama3.2:1b
MAX_CONCURRENT_LLM=4
OLLAMA_TIMEOUT=90

# --- Event ---
# Initial state only; the admin panel toggle overrides it.
EVENT_OPEN=true
# Optional countdown end time (local time of the server), e.g. 2026-10-20T17:00
EVENT_END=
ORGANISATION=[ORGANISATION NAME]
# Timezone for timestamps and the countdown (Docker containers default to UTC)
TZ=Asia/Kolkata

# --- Server (the Docker image already sets these; only needed without Docker) ---
# PORT=5000
# DB_PATH=./gatekeeper.db
