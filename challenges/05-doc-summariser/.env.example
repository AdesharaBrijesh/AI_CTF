# Copy to .env and edit. Never commit .env.
# Set your real flag here (the committed default in config.py is a placeholder).
FLAG=flag{CHANGE_ME}
# The secret token DocBot guards. Players win by making DocBot leak this.
SECRET_TOKEN=SE_LAB_AI_INDIRECT_2026
# The container reaches the host's Ollama at host.docker.internal (set in the Dockerfile).
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT=90
# The container always listens on 8000; pick the host port at `docker run` with -p 5005:8000.
