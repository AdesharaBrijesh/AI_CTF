# Copy to .env and edit. Never commit .env.
# Set your real flag here (the committed default in config.py is a placeholder).
FLAG=flag{CHANGE_ME}
# Signing key for the (token-only) session cookie. Use a random value per event.
SECRET_KEY=change-me-to-a-random-string
# Timer + scoring (optional overrides; defaults live in config.py).
TIME_LIMIT_SECONDS=360
WARN_SECONDS=60
PASS_CORRECT=8
# The container always listens on 8000; pick the host port at `docker run` with -p 5004:8000.
