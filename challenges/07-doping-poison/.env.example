# Copy to .env and edit. Never commit .env.
# Set your real flag here (the committed default in config.py is a placeholder).
FLAG=CTF{CHANGE_ME}
# Flask session signing key for the (token-only) progress cookie.
SECRET_KEY=change-me-for-your-event
# The container always listens on 8000; pick the host port with -p 5007:8000.
# Dataset reproducibility and difficulty (see config.py for the full set).
# SEED=1337
# SIGNATURE_SHIFT=3.2
# MAX_FLIPS=130
