# Copy to .env and edit. Never commit .env.
FLAG=CTF{CHANGE_ME}
# Without Docker set PORT=5009 (Docker publishes container port 8000 on host 5009).
PORT=5009
# Optional: fixed key so sessions survive a restart.
SECRET_KEY=
# Optional tuning (see config.py).
# PROXY_PENALTY=1.6
# PROXY_BOOST=0.8
# DATASET_SIZE=2000
# RANDOM_SEED=42
