# CTF Hub — copy to hub/.env and fill in real values before the event.
# Generate a random secret key: python3 -c "import secrets; print(secrets.token_hex(32))"

HUB_SECRET_KEY=CHANGE_ME
HUB_ADMIN_PASSWORD=CHANGE_ME
EVENT_NAME=AI Security CTF
HUB_DB_PATH=/data/hub.db

# ── Challenge flags ──────────────────────────────────────────────────────────
# Set the SAME values you put in each challenge's .env file.
# The hub uses these to validate flag submissions.

# Challenge 01: Gatekeeper (also in challenges/01-gatekeeper/.env)
C01_FLAG_L1=AICTF{CHANGE_ME}
C01_FLAG_L2=AICTF{CHANGE_ME}
C01_FLAG_L3=AICTF{CHANGE_ME}
C01_FLAG_L4=AICTF{CHANGE_ME}
C01_FLAG_L5=AICTF{CHANGE_ME}

# Challenge 02: Injection Chat (also in challenges/02-injection-chat/.env)
C02_FLAG=flag{CHANGE_ME}

# Challenge 03: Query Bot (also in challenges/03-query-bot/.env)
C03_FLAG=flag{CHANGE_ME}

# Challenge 04: Phish Triage (also in challenges/04-phish-triage/.env)
C04_FLAG=flag{CHANGE_ME}

# Challenge 05: Doc Summariser (also in challenges/05-doc-summariser/.env)
C05_FLAG=flag{CHANGE_ME}

# Challenge 06: Code Assistant (also in challenges/06-code-assistant/.env)
C06_FLAG=flag{CHANGE_ME}

# Challenge 07: Doping Poison (also in challenges/07-doping-poison/.env)
C07_FLAG=CTF{CHANGE_ME}

# Challenge 08: Prompt Injection Ladder (also in root .env)
C08_FLAG_L1=FLAG{CHANGE_ME}
C08_FLAG_L2=FLAG{CHANGE_ME}
C08_FLAG_L3=FLAG{CHANGE_ME}
C08_FLAG_L4=FLAG{CHANGE_ME}
C08_FLAG_L5=FLAG{CHANGE_ME}
C08_FLAG_L6=FLAG{CHANGE_ME}
C08_FLAG_L7=FLAG{CHANGE_ME}
C08_FLAG_L8=FLAG{CHANGE_ME}
C08_FLAG_L9=FLAG{CHANGE_ME}
C08_FLAG_L10=FLAG{CHANGE_ME}

# Challenge 09: Explain Yourself (also in challenges/09-explain-yourself/.env)
C09_FLAG=CTF{CHANGE_ME}
