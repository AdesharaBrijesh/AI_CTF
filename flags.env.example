# Master flag reference — copy to flags.env (git-ignored) as your private list.
# Each challenge reads its flags from its own .env, not from this file.
# This file is just a reminder of what to fill in.

# ── Challenge 01: Gatekeeper (challenges/01-gatekeeper/.env) ──────────────
C01_FLAG_L1=AICTF{CHANGE_ME}
C01_FLAG_L2=AICTF{CHANGE_ME}
C01_FLAG_L3=AICTF{CHANGE_ME}
C01_FLAG_L4=AICTF{CHANGE_ME}
C01_FLAG_L5=AICTF{CHANGE_ME}

# ── Challenge 02: Injection Chat (challenges/02-injection-chat/.env) ───────
C02_FLAG=flag{CHANGE_ME}

# ── Challenge 03: Query Bot (challenges/03-query-bot/.env) ─────────────────
C03_FLAG=flag{CHANGE_ME}

# ── Challenge 04: Phish Triage (challenges/04-phish-triage/.env) ───────────
C04_FLAG=flag{CHANGE_ME}

# ── Challenge 05: Doc Summariser (challenges/05-doc-summariser/.env) ───────
C05_FLAG=flag{CHANGE_ME}
C05_SECRET_TOKEN=CHANGE_ME        # the token DocBot guards; set separately in .env

# ── Challenge 06: Code Assistant (challenges/06-code-assistant/.env) ───────
C06_FLAG=flag{CHANGE_ME}          # use a random-looking value; the planted key is built from it

# ── Challenge 07: Doping Poison (challenges/07-doping-poison/.env) ─────────
C07_FLAG=CTF{CHANGE_ME}

# ── Challenge 08: Prompt Injection Ladder (root .env) ─────────────────────
C08_FLAG_L1=FLAG{CHANGE_ME}
C08_FLAG_L2=FLAG{CHANGE_ME}
C08_FLAG_L3=FLAG{CHANGE_ME}
C08_FLAG_L4=FLAG{CHANGE_ME}
C08_FLAG_L5=FLAG{CHANGE_ME}
C08_FLAG_L6=FLAG{CHANGE_ME}
C08_FLAG_L7=FLAG{CHANGE_ME}
C08_FLAG_L8=FLAG{CHANGE_ME}
C08_FLAG_L9=FLAG{CHANGE_ME}
C08_FLAG_L10=FLAG{CHANGE_ME}

# ── Challenge 09: Explain Yourself (challenges/09-explain-yourself/.env) ───
C09_FLAG=CTF{CHANGE_ME}
